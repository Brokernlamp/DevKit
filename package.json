{
  "name": "devkit-ai-cli",
  "version": "0.1.0",
  "description": "DevKit: the missing utility layer for AI-powered software development.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devkit-ai": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-executable.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "devkit",
    "ai",
    "agents",
    "project-memory",
    "developer-tools",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brokernlamp/DevKit.git"
  },
  "bugs": {
    "url": "https://github.com/Brokernlamp/DevKit/issues"
  },
  "homepage": "https://github.com/Brokernlamp/DevKit#readme",
  "dependencies": {
    "commander": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
